{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Verified AquaVault administrator identity authorized to manage global app controls and customer support.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the verified administrator." },
        "email": { "type": "string", "description": "Verified administrator email address." },
        "username": { "type": "string", "description": "Unique administrator username." },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "OPS_ADMIN"], "description": "Administrative privilege tier." },
        "active": { "type": "boolean", "description": "Whether this admin account is currently active." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "uid",
        "email",
        "username",
        "role",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppGlobalConfig": {
      "title": "AppGlobalConfig",
      "description": "Admin-controlled feature toggles, maintenance mode, brand broadcast banner, and invoice studio defaults.",
      "type": "object",
      "properties": {
        "featureWarranty": { "type": "boolean", "description": "Enable or disable Warranty Dashboard in customer app." },
        "featureDevices": { "type": "boolean", "description": "Enable or disable Devices, Bills & Service in customer app." },
        "featureCalculator": { "type": "boolean", "description": "Enable or disable Hisab-Kitab Calculator in customer app." },
        "featureInvoice": { "type": "boolean", "description": "Enable or disable Colorful Invoice Generator in customer app." },
        "featureNotes": { "type": "boolean", "description": "Enable or disable Personal Notepad & Sync in customer app." },
        "featureHub": { "type": "boolean", "description": "Enable or disable New Tab Apps Hub in customer app." },
        "featurePrivacy": { "type": "boolean", "description": "Enable or disable DPDP Privacy & Settings in customer app." },
        "featurePwaPopup": { "type": "boolean", "description": "Enable or disable 7-second PWA Install top popup." },
        "maintenanceMode": { "type": "boolean", "description": "Temporarily pause customer app with maintenance notice." },
        "maintenanceMessage": { "type": "string", "description": "Customer-facing maintenance notice message." },
        "announcementActive": { "type": "boolean", "description": "Show top brand announcement banner in customer app." },
        "announcementText": { "type": "string", "description": "Broadcast announcement text for customers." },
        "defaultGstPercent": { "type": "number", "description": "Default GST percentage for Invoice Generator." },
        "defaultInvoicePalette": { "type": "string", "enum": ["violet", "sapphire", "emerald", "crimson", "gold", "obsidian"], "description": "Default color palette for Invoice Generator." },
        "defaultTheme": { "type": "string", "enum": ["light", "dark"], "description": "Default Day or Night theme." },
        "updatedByUid": { "type": "string", "description": "UID of the admin who made the last update." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "featureWarranty",
        "featureDevices",
        "featureCalculator",
        "featureInvoice",
        "featureNotes",
        "featureHub",
        "featurePrivacy",
        "featurePwaPopup",
        "maintenanceMode",
        "maintenanceMessage",
        "announcementActive",
        "announcementText",
        "defaultGstPercent",
        "defaultInvoicePalette",
        "defaultTheme",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "HubAppItem": {
      "title": "HubAppItem",
      "description": "Admin-managed app, website, or utility link shown in the Customer New Tab Apps Hub.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display title of the app or website." },
        "category": { "type": "string", "enum": ["Website", "New App", "Tool"], "description": "Category filter badge." },
        "desc": { "type": "string", "description": "Short description shown on the card." },
        "url": { "type": "string", "description": "HTTPS external destination URL." },
        "icon": { "type": "string", "description": "Icon identifier from SVG icon set." },
        "enabled": { "type": "boolean", "description": "Whether this item is visible to customers." },
        "sortOrder": { "type": "integer", "description": "Display order priority." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "name",
        "category",
        "desc",
        "url",
        "icon",
        "enabled",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable security and administrative action log for anti-hacker auditing.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "description": "Firebase Auth UID of the admin performing the action." },
        "actorEmail": { "type": "string", "description": "Verified email of the admin performing the action." },
        "eventType": { "type": "string", "enum": ["LOGIN_VERIFIED", "CONFIG_UPDATED", "WARRANTY_MODIFIED", "TICKET_UPDATED", "HUB_UPDATED", "SECURITY_ALERT", "PASSWORD_RESET"], "description": "Audit event classification." },
        "summary": { "type": "string", "description": "Human-readable audit event summary." },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"], "description": "Security severity level." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." }
      },
      "required": [
        "actorUid",
        "actorEmail",
        "eventType",
        "summary",
        "severity",
        "createdAt"
      ]
    },
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Authenticated customer profile, theme preference, cloud sync toggles, and DPDP Act consent record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the customer." },
        "displayName": { "type": "string", "description": "Customer display name." },
        "email": { "type": "string", "description": "Customer Google account email." },
        "customerCode": { "type": "string", "description": "Unique AquaVault customer identifier." },
        "phone": { "type": "string", "description": "Optional customer contact number." },
        "address": { "type": "string", "description": "Optional installation address." },
        "darkModeEnabled": { "type": "boolean", "description": "Whether Black + Purple Night Mode is active." },
        "dpdpConsentAccepted": { "type": "boolean", "description": "Whether DPDP Act data processing consent is granted." },
        "dpdpConsentVersion": { "type": "string", "description": "Version tag of accepted DPDP notice." },
        "gmailSyncEnabled": { "type": "boolean", "description": "Whether personal notepad Gmail sync workflow is enabled." },
        "driveAutoSaveEnabled": { "type": "boolean", "description": "Whether personal notepad Drive auto-save workflow is enabled." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "displayName",
        "email",
        "customerCode",
        "darkModeEnabled",
        "dpdpConsentAccepted",
        "dpdpConsentVersion",
        "gmailSyncEnabled",
        "driveAutoSaveEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "WarrantyUnit": {
      "title": "WarrantyUnit",
      "description": "Installed Water Level Controller or Water Stopper unit with warranty timeline and digital invoice metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "deviceType": { "type": "string", "enum": ["WATER_LEVEL_CONTROLLER", "WATER_STOPPER"], "description": "Category of installed water hardware." },
        "productName": { "type": "string", "description": "Commercial model name." },
        "modelCode": { "type": "string", "description": "Hardware model code." },
        "serialNumber": { "type": "string", "description": "Unique hardware serial number." },
        "locationTag": { "type": "string", "description": "Installation tag such as Overhead Tank or Underground Sump." },
        "installEpochDay": { "type": "integer", "description": "Installation date as epoch days (UTC)." },
        "warrantyTotalDays": { "type": "integer", "description": "Total warranty coverage duration in days." },
        "unitStatus": { "type": "string", "enum": ["ONLINE", "STANDBY", "ATTENTION"], "description": "Current operational status tag." },
        "invoiceNumber": { "type": "string", "description": "Digital bill invoice number." },
        "purchaseAmountInr": { "type": "number", "description": "Base purchase amount in INR." },
        "gstAmountInr": { "type": "number", "description": "GST tax amount in INR." },
        "dealerName": { "type": "string", "description": "Authorized dealer or distributor name." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "deviceType",
        "productName",
        "modelCode",
        "serialNumber",
        "locationTag",
        "installEpochDay",
        "warrantyTotalDays",
        "unitStatus",
        "invoiceNumber",
        "purchaseAmountInr",
        "gstAmountInr",
        "dealerName",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Customer service or inspection request logged for an installed unit.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "ticketNumber": { "type": "string", "description": "Generated service ticket identifier." },
        "warrantyId": { "type": "string", "description": "Document ID of the associated WarrantyUnit." },
        "deviceLabel": { "type": "string", "description": "Readable device name and location." },
        "issueCategory": { "type": "string", "description": "Issue category label." },
        "issueNote": { "type": "string", "description": "Customer issue description." },
        "preferredSlot": { "type": "string", "description": "Preferred technician visit slot." },
        "status": { "type": "string", "enum": ["LOGGED", "SCHEDULED", "RESOLVED"], "description": "Current ticket status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "ticketNumber",
        "warrantyId",
        "deviceLabel",
        "issueCategory",
        "issueNote",
        "preferredSlot",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvoiceRecord": {
      "title": "InvoiceRecord",
      "description": "Colorful Invoice Studio document stored per customer with GST totals and payment state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "invoiceNo": { "type": "string", "description": "Unique invoice number." },
        "clientName": { "type": "string", "description": "Billed customer name." },
        "grandTotal": { "type": "number", "description": "Grand total payable in INR." },
        "status": { "type": "string", "enum": ["PAID", "PENDING", "OVERDUE"], "description": "Payment state." },
        "palette": { "type": "string", "enum": ["violet", "sapphire", "emerald", "crimson", "gold", "obsidian"], "description": "Invoice color palette." },
        "invoiceDate": { "type": "string", "description": "ISO date of issue." },
        "dueDate": { "type": "string", "description": "ISO due date." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "invoiceNo",
        "clientName",
        "grandTotal",
        "status",
        "palette",
        "invoiceDate",
        "dueDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "CalcEntry": {
      "title": "CalcEntry",
      "description": "Hisab-Kitab calculator tape entry persisted to the user's cloud history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "label": { "type": "string", "description": "Optional note label for the calculation." },
        "expression": { "type": "string", "description": "Readable math expression." },
        "resultValue": { "type": "number", "description": "Computed numeric result." },
        "resultFormatted": { "type": "string", "description": "Formatted display string." },
        "mode": { "type": "string", "enum": ["STANDARD", "QTY_RATE", "SPLIT", "MARGIN"], "description": "Calculator mode used." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "label",
        "expression",
        "resultValue",
        "resultFormatted",
        "mode",
        "createdAt",
        "updatedAt"
      ]
    },
    "PersonalNote": {
      "title": "PersonalNote",
      "description": "Customer personal notepad entry synced to Cloud Firestore with Gmail and Drive sync metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "title": { "type": "string", "description": "Note headline." },
        "content": { "type": "string", "description": "Full text body of the note." },
        "tag": { "type": "string", "description": "Category tag." },
        "pinned": { "type": "boolean", "description": "Whether the note is pinned to the top." },
        "gmailSyncState": { "type": "string", "enum": ["SYNCED", "QUEUED", "DISABLED"], "description": "Gmail sync indicator state." },
        "driveSyncState": { "type": "string", "enum": ["AUTO_SAVED", "PENDING", "OFFLINE_LOCAL"], "description": "Google Drive auto-save indicator state." },
        "lastSyncedLabel": { "type": "string", "description": "Human-readable sync status label." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "title",
        "content",
        "tag",
        "pinned",
        "gmailSyncState",
        "driveSyncState",
        "lastSyncedLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "PrivacyAuditLog": {
      "title": "PrivacyAuditLog",
      "description": "Immutable DPDP Act consent and privacy request log entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "actionType": { "type": "string", "enum": ["CONSENT_GRANTED", "CONSENT_WITHDRAWN", "DATA_EXPORT", "DELETION_REQUESTED"], "description": "Type of DPDP privacy event." },
        "details": { "type": "string", "description": "Transparent description of the action." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp updated via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "actionType",
        "details",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Verified AquaVault administrator directory strictly protected against privilege escalation."
    },
    "/appConfig/{configId}": {
      "schema": { "$ref": "#/entities/AppGlobalConfig" },
      "description": "Admin-controlled feature flags, maintenance switch, broadcast banner, and invoice defaults."
    },
    "/hubApps/{appId}": {
      "schema": { "$ref": "#/entities/HubAppItem" },
      "description": "Admin-managed external websites, apps, and utilities for the New Tab Apps Hub."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable append-only security and admin activity audit logs."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/CustomerProfile" },
      "description": "Customer profile, theme preference, cloud sync toggles, and DPDP consent."
    },
    "/users/{userId}/warranties/{warrantyId}": {
      "schema": { "$ref": "#/entities/WarrantyUnit" },
      "description": "Installed Water Level Controllers and Water Stoppers with warranty and bill data."
    },
    "/users/{userId}/serviceRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ServiceRequest" },
      "description": "Customer service and inspection tickets."
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/InvoiceRecord" },
      "description": "Saved colorful customer invoices."
    },
    "/users/{userId}/calcEntries/{entryId}": {
      "schema": { "$ref": "#/entities/CalcEntry" },
      "description": "Hisab-Kitab calculator running history tape."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/PersonalNote" },
      "description": "Personal notepad entries synced across sessions."
    },
    "/users/{userId}/privacyRequests/{reqId}": {
      "schema": { "$ref": "#/entities/PrivacyAuditLog" },
      "description": "DPDP Act consent and privacy audit trail."
    }
  }
}
