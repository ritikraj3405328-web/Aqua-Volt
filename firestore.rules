rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net — Deny all unauthenticated or unmatched read/write access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict Server-Side Admin Gate — Exclusively Authorized Firebase Admin UID
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'Y8zmDKBgubWIVvhufftRPPjG7HC3';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function hasValidKeyCount() {
      return request.resource != null &&
        request.resource.data.keys().size() >= 1 &&
        request.resource.data.keys().size() <= 35;
    }

    function isOptionalHttpsUrl(url) {
      return url is string && url.size() <= 500 && (url == '' || url.matches('^https://.+'));
    }

    // 3. Entity Validation Blueprints

    // Public Non-Sensitive Unit Record (Strictly ZERO full phone numbers, addresses, or bills allowed)
    // Only allows pre-masked phone like "98XXXXXX45" or "Hidden"
    function isValidPublicUnit(data) {
      return data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        (!('maskedPhone' in data) || (
          data.maskedPhone is string &&
          data.maskedPhone.size() >= 4 &&
          data.maskedPhone.size() <= 20 &&
          data.maskedPhone.matches('^([0-9]{2}X{4,10}[0-9]{2}|X{6,12}|Hidden)$')
        )) &&
        data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 140 &&
        data.hardwareType is string && data.hardwareType in ['controller', 'stopper', 'Water Level Controller', 'Water Stopper'] &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 1000 &&
        data.installDate is string && data.installDate.size() >= 8 && data.installDate.size() <= 20 &&
        data.expiryDate is string && data.expiryDate.size() >= 8 && data.expiryDate.size() <= 20 &&
        data.status is string && data.status in ['ACTIVE', 'EXPIRED'] &&
        isValidTimestamp(data.updatedAt);
    }

    // Private Admin-Only Customer & Warranty Record (Holds sensitive phone numbers & addresses)
    function isValidPrivateCustomer(data) {
      return data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.mobileNumber is string && data.mobileNumber.size() >= 3 && data.mobileNumber.size() <= 30 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 250 &&
        data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 140 &&
        data.hardwareType is string && data.hardwareType in ['controller', 'stopper', 'Water Level Controller', 'Water Stopper'] &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 1000 &&
        data.serialNumber is string && data.serialNumber.size() >= 1 && data.serialNumber.size() <= 80 &&
        data.installDate is string && data.installDate.size() >= 8 && data.installDate.size() <= 20 &&
        data.expiryDate is string && data.expiryDate.size() >= 8 && data.expiryDate.size() <= 20 &&
        data.warrantyDays is int && data.warrantyDays >= 0 && data.warrantyDays <= 3650 &&
        data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 100000000 &&
        data.gstRate is number && data.gstRate >= 0 && data.gstRate <= 50 &&
        data.invoiceNo is string && data.invoiceNo.size() >= 1 && data.invoiceNo.size() <= 60 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // Private Admin-Only Generated Invoice Record
    function isValidPrivateInvoice(data) {
      return data.invoiceNo is string && data.invoiceNo.size() >= 1 && data.invoiceNo.size() <= 60 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.mobileNumber is string && data.mobileNumber.size() <= 30 &&
        data.address is string && data.address.size() <= 250 &&
        data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 200 &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 10000 &&
        data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 100000000 &&
        data.discountPct is number && data.discountPct >= 0 && data.discountPct <= 100 &&
        data.taxPct is number && data.taxPct >= 0 && data.taxPct <= 50 &&
        data.grandTotal is number && data.grandTotal >= 0 && data.grandTotal <= 1000000000 &&
        data.status is string && data.status in ['PAID', 'PENDING', 'OVERDUE'] &&
        data.palette is string && data.palette in ['violet', 'sapphire', 'emerald', 'crimson', 'gold', 'obsidian'] &&
        data.invoiceDate is string && data.invoiceDate.size() >= 8 && data.invoiceDate.size() <= 20 &&
        data.dueDate is string && data.dueDate.size() >= 8 && data.dueDate.size() <= 20 &&
        (!('warrantyStartDate' in data) || (data.warrantyStartDate is string && data.warrantyStartDate.size() <= 20)) &&
        (!('warrantyExpiryDate' in data) || (data.warrantyExpiryDate is string && data.warrantyExpiryDate.size() <= 20)) &&
        data.driveSaved is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // Private Review Record (All 1-5 Star Reviews + Customer Phone Number — Strictly Admin-Only Read)
    function isValidPrivateReview(data) {
      return data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 25 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.message is string && data.message.size() >= 3 && data.message.size() <= 1000 &&
        (!('productName' in data) || (data.productName is string && data.productName.size() <= 140)) &&
        data.status is string && data.status in ['SUBMITTED', 'REVIEWED', 'RESOLVED', 'HIDDEN'] &&
        isValidTimestamp(data.createdAt);
    }

    // Public Review Record (Strictly 4 & 5 Star Reviews ONLY, ZERO Phone Numbers Allowed)
    function isValidPublicReview(data) {
      return data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.rating is int && data.rating >= 4 && data.rating <= 5 &&
        data.message is string && data.message.size() >= 3 && data.message.size() <= 1000 &&
        (!('productName' in data) || (data.productName is string && data.productName.size() <= 140)) &&
        data.verified is bool &&
        isValidTimestamp(data.createdAt);
    }

    // Public Service Request Submission (Write-Only for Public, Read/Update/Delete Admin-Only)
    function isValidPublicServiceRequest(data) {
      return data.ticketNumber is string && data.ticketNumber.size() >= 3 && data.ticketNumber.size() <= 40 &&
        data.unitId is string && data.unitId.size() <= 80 &&
        data.unitName is string && data.unitName.size() >= 1 && data.unitName.size() <= 160 &&
        data.issue is string && data.issue.size() >= 2 && data.issue.size() <= 120 &&
        data.notes is string && data.notes.size() >= 2 && data.notes.size() <= 600 &&
        (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 25)) &&
        data.status is string && data.status in ['Logged', 'Scheduled', 'Resolved'] &&
        isValidTimestamp(data.createdAt);
    }

    // Dynamic Business & App Settings (Public Read, Admin-Only Write)
    function isValidBusinessConfig(data) {
      return data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
        data.tagline is string && data.tagline.size() <= 200 &&
        data.aboutText is string && data.aboutText.size() <= 1200 &&
        data.address is string && data.address.size() <= 300 &&
        data.email is string && data.email.size() <= 150 &&
        data.gstin is string && data.gstin.size() <= 40 &&
        data.businessPhone is string && data.businessPhone.size() <= 30 &&
        data.personalPhone is string && data.personalPhone.size() <= 30 &&
        data.whatsappNumber is string && data.whatsappNumber.size() <= 30 &&
        isOptionalHttpsUrl(data.googleMapsUrl) &&
        data.googleRating is number && data.googleRating >= 1 && data.googleRating <= 5 &&
        data.googleReviewCount is string && data.googleReviewCount.size() <= 40 &&
        isOptionalHttpsUrl(data.googleReviewLink) &&
        isOptionalHttpsUrl(data.websiteUrl) &&
        isOptionalHttpsUrl(data.instagramUrl) &&
        isOptionalHttpsUrl(data.facebookUrl) &&
        isOptionalHttpsUrl(data.youtubeUrl) &&
        data.products is list && data.products.size() <= 30 &&
        data.updatedByUid is string && data.updatedByUid == request.auth.uid &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdminRecord(data, adminId) {
      return data.uid is string && data.uid == adminId &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        data.role is string && data.role in ['SUPER_ADMIN', 'OPS_ADMIN'] &&
        data.active is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAppConfig(data) {
      return data.featureWarranty is bool &&
        data.featureDevices is bool &&
        data.featureInvoice is bool &&
        data.featureHub is bool &&
        data.featurePrivacy is bool &&
        data.featurePwaPopup is bool &&
        data.maintenanceMode is bool &&
        data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300 &&
        data.announcementActive is bool &&
        data.announcementText is string && data.announcementText.size() <= 300 &&
        data.defaultGstPercent is number && data.defaultGstPercent >= 0 && data.defaultGstPercent <= 50 &&
        data.defaultInvoicePalette is string && data.defaultInvoicePalette in ['violet', 'sapphire', 'emerald', 'crimson', 'gold', 'obsidian'] &&
        data.defaultTheme is string && data.defaultTheme in ['light', 'dark'] &&
        data.updatedByUid is string && data.updatedByUid == request.auth.uid &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidHubApp(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.category is string && data.category in ['Website', 'New App', 'Tool'] &&
        data.desc is string && data.desc.size() >= 1 && data.desc.size() <= 300 &&
        data.url is string && data.url.size() >= 8 && data.url.size() <= 500 &&
        data.url.matches('^https://.+') &&
        data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 40 &&
        data.enabled is bool &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdminAuditLog(data) {
      return data.actorUid is string && data.actorUid == request.auth.uid &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 200 &&
        data.eventType is string && data.eventType in [
          'LOGIN_VERIFIED', 'CONFIG_UPDATED', 'WARRANTY_MODIFIED',
          'TICKET_UPDATED', 'HUB_UPDATED', 'INVOICE_GENERATED',
          'REVIEW_MODERATED', 'SETTINGS_UPDATED', 'SECURITY_ALERT', 'PASSWORD_RESET'
        ] &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
        data.severity is string && data.severity in ['INFO', 'WARNING', 'CRITICAL'] &&
        isValidTimestamp(data.createdAt);
    }

    function isValidCustomerProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() <= 200 &&
        data.customerCode is string && data.customerCode.size() >= 1 && data.customerCode.size() <= 40 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
        data.darkModeEnabled is bool &&
        data.dpdpConsentAccepted is bool &&
        data.dpdpConsentVersion is string && data.dpdpConsentVersion.size() >= 1 && data.dpdpConsentVersion.size() <= 30 &&
        data.gmailSyncEnabled is bool &&
        data.driveAutoSaveEnabled is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidWarrantyUnit(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.deviceType is string && data.deviceType in ['WATER_LEVEL_CONTROLLER', 'WATER_STOPPER'] &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120 &&
        data.modelCode is string && data.modelCode.size() >= 1 && data.modelCode.size() <= 60 &&
        data.serialNumber is string && data.serialNumber.size() >= 1 && data.serialNumber.size() <= 80 &&
        data.locationTag is string && data.locationTag.size() >= 1 && data.locationTag.size() <= 80 &&
        data.installEpochDay is int && data.installEpochDay >= 10000 && data.installEpochDay <= 100000 &&
        data.warrantyTotalDays is int && data.warrantyTotalDays >= 1 && data.warrantyTotalDays <= 3650 &&
        data.unitStatus is string && data.unitStatus in ['ONLINE', 'STANDBY', 'ATTENTION'] &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 60 &&
        data.purchaseAmountInr is number && data.purchaseAmountInr >= 0 && data.purchaseAmountInr <= 10000000 &&
        data.gstAmountInr is number && data.gstAmountInr >= 0 && data.gstAmountInr <= 2000000 &&
        data.dealerName is string && data.dealerName.size() >= 1 && data.dealerName.size() <= 120 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidServiceRequest(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.ticketNumber is string && data.ticketNumber.size() >= 1 && data.ticketNumber.size() <= 40 &&
        isValidId(data.warrantyId) &&
        data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 150 &&
        data.issueCategory is string && data.issueCategory.size() >= 1 && data.issueCategory.size() <= 60 &&
        data.issueNote is string && data.issueNote.size() >= 1 && data.issueNote.size() <= 1000 &&
        data.preferredSlot is string && data.preferredSlot.size() >= 1 && data.preferredSlot.size() <= 60 &&
        data.status is string && data.status in ['LOGGED', 'SCHEDULED', 'RESOLVED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidPrivacyAuditLog(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.actionType is string && data.actionType in ['CONSENT_GRANTED', 'CONSENT_WITHDRAWN', 'DATA_EXPORT', 'DELETION_REQUESTED'] &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 500 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // =========================================================================
    // 4. PUBLIC TRUST DIRECTORY (Public Read-Only, Admin-Only Write, ZERO Full Phone/Address/Bill Fields)
    // =========================================================================
    match /public_units/{unitId} {
      allow get, list: if true;

      allow create, update: if isAdmin() &&
        isValidId(unitId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll([
          'customerName', 'modelName', 'hardwareType', 'quantity',
          'installDate', 'expiryDate', 'status', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'customerName', 'maskedPhone', 'modelName', 'hardwareType', 'quantity',
          'installDate', 'expiryDate', 'status', 'updatedAt'
        ]) &&
        isValidPublicUnit(incoming());

      allow delete: if isAdmin() && isValidId(unitId);
    }

    // =========================================================================
    // 5. SMART CUSTOMER REVIEWS (All Reviews Private; ONLY 4★ & 5★ Public Without Phone)
    // =========================================================================
    match /private_reviews/{reviewId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(reviewId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll(['customerName', 'phoneNumber', 'rating', 'message', 'status', 'createdAt']) &&
        incoming().keys().hasOnly(['customerName', 'phoneNumber', 'rating', 'message', 'productName', 'status', 'createdAt']) &&
        isValidPrivateReview(incoming()) &&
        incoming().status == 'SUBMITTED';

      allow update, delete: if isAdmin() && isValidId(reviewId);
    }

    match /public_reviews/{reviewId} {
      allow get, list: if resource.data.rating >= 4;

      allow create: if isValidId(reviewId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll(['customerName', 'rating', 'message', 'verified', 'createdAt']) &&
        incoming().keys().hasOnly(['customerName', 'rating', 'message', 'productName', 'verified', 'createdAt']) &&
        isValidPublicReview(incoming()) &&
        (isAdmin() || incoming().verified == false);

      allow update: if isAdmin() &&
        isValidId(reviewId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll(['customerName', 'rating', 'message', 'verified', 'createdAt']) &&
        incoming().keys().hasOnly(['customerName', 'rating', 'message', 'productName', 'verified', 'createdAt']) &&
        isValidPublicReview(incoming());

      allow delete: if isAdmin() && isValidId(reviewId);
    }

    // =========================================================================
    // 6. PRIVATE SERVICE TICKETS (Write-Only by Visitors, Read/Manage Admin-Only)
    // =========================================================================
    match /private_service_requests/{reqId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(reqId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll(['ticketNumber', 'unitId', 'unitName', 'issue', 'notes', 'status', 'createdAt']) &&
        incoming().keys().hasOnly(['ticketNumber', 'unitId', 'unitName', 'issue', 'notes', 'contactPhone', 'status', 'createdAt']) &&
        isValidPublicServiceRequest(incoming()) &&
        incoming().status in ['Logged', 'Scheduled'];

      allow update, delete: if isAdmin() && isValidId(reqId);
    }

    // =========================================================================
    // 7. PRIVATE ADMIN-ONLY VAULTS (Customer Phone Numbers, Places, Bills & Drive Webhook)
    // =========================================================================
    match /private_customers/{customerId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(customerId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll([
          'customerName', 'mobileNumber', 'address', 'modelName', 'hardwareType',
          'quantity', 'serialNumber', 'installDate', 'expiryDate', 'warrantyDays',
          'basePrice', 'gstRate', 'invoiceNo', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'customerName', 'mobileNumber', 'address', 'modelName', 'hardwareType',
          'quantity', 'serialNumber', 'installDate', 'expiryDate', 'warrantyDays',
          'basePrice', 'gstRate', 'invoiceNo', 'createdAt', 'updatedAt'
        ]) &&
        isValidPrivateCustomer(incoming());

      allow update: if isAdmin() &&
        isValidId(customerId) &&
        hasValidKeyCount() &&
        isValidPrivateCustomer(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'customerName', 'mobileNumber', 'address', 'modelName', 'hardwareType',
          'quantity', 'serialNumber', 'installDate', 'expiryDate', 'warrantyDays',
          'basePrice', 'gstRate', 'invoiceNo', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(customerId);
    }

    match /private_invoices/{invoiceId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(invoiceId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll([
          'invoiceNo', 'customerName', 'mobileNumber', 'address', 'modelName',
          'quantity', 'unitPrice', 'discountPct', 'taxPct', 'grandTotal',
          'status', 'palette', 'invoiceDate', 'dueDate', 'driveSaved',
          'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'invoiceNo', 'customerId', 'customerName', 'mobileNumber', 'address',
          'modelName', 'hardwareType', 'quantity', 'unitPrice', 'discountPct',
          'taxPct', 'grandTotal', 'status', 'palette', 'invoiceDate', 'dueDate',
          'warrantyStartDate', 'warrantyExpiryDate', 'syncToCustomerLive',
          'driveSaved', 'driveFileUrl', 'createdAt', 'updatedAt'
        ]) &&
        isValidPrivateInvoice(incoming());

      allow update: if isAdmin() &&
        isValidId(invoiceId) &&
        hasValidKeyCount() &&
        isValidPrivateInvoice(incoming()) &&
        incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin() && isValidId(invoiceId);
    }

    match /adminSecrets/{secretId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(secretId);
    }

    // =========================================================================
    // 8. ADMIN & DYNAMIC BUSINESS CONFIG (Public Read; Admin-Only Write)
    // =========================================================================
    match /admins/{adminId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(adminId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll(['uid', 'email', 'role', 'active', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'email', 'role', 'active', 'createdAt', 'updatedAt']) &&
        isValidAdminRecord(incoming(), adminId);

      allow update: if isAdmin() &&
        isValidId(adminId) &&
        hasValidKeyCount() &&
        isValidAdminRecord(incoming(), adminId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'active', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(adminId) && request.auth.uid != adminId;
    }

    match /businessConfig/{configId} {
      allow get, list: if true;

      allow create, update: if isAdmin() &&
        isValidId(configId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll([
          'businessName', 'tagline', 'aboutText', 'address', 'email', 'gstin',
          'businessPhone', 'personalPhone', 'whatsappNumber',
          'googleMapsUrl', 'googleRating', 'googleReviewCount', 'googleReviewLink',
          'websiteUrl', 'instagramUrl', 'facebookUrl', 'youtubeUrl',
          'products', 'updatedByUid', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'businessName', 'tagline', 'aboutText', 'address', 'email', 'gstin',
          'businessPhone', 'personalPhone', 'whatsappNumber',
          'googleMapsUrl', 'googleRating', 'googleReviewCount', 'googleReviewLink',
          'websiteUrl', 'instagramUrl', 'facebookUrl', 'youtubeUrl',
          'products', 'updatedByUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidBusinessConfig(incoming());

      allow delete: if isAdmin() && isValidId(configId);
    }

    match /appConfig/{configId} {
      allow get, list: if true;

      allow create: if isAdmin() &&
        isValidId(configId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll([
          'featureWarranty', 'featureDevices', 'featureInvoice',
          'featureHub', 'featurePrivacy', 'featurePwaPopup',
          'maintenanceMode', 'maintenanceMessage', 'announcementActive', 'announcementText',
          'defaultGstPercent', 'defaultInvoicePalette', 'defaultTheme',
          'updatedByUid', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'featureWarranty', 'featureDevices', 'featureCalculator', 'featureInvoice',
          'featureNotes', 'featureHub', 'featurePrivacy', 'featurePwaPopup',
          'maintenanceMode', 'maintenanceMessage', 'announcementActive', 'announcementText',
          'defaultGstPercent', 'defaultInvoicePalette', 'defaultTheme',
          'updatedByUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidAppConfig(incoming());

      allow update: if isAdmin() &&
        isValidId(configId) &&
        hasValidKeyCount() &&
        isValidAppConfig(incoming()) &&
        incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin() && isValidId(configId);
    }

    match /hubApps/{appId} {
      allow get, list: if true;

      allow create: if isAdmin() &&
        isValidId(appId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll(['name', 'category', 'desc', 'url', 'icon', 'enabled', 'sortOrder', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['name', 'category', 'desc', 'url', 'icon', 'enabled', 'sortOrder', 'createdAt', 'updatedAt']) &&
        isValidHubApp(incoming());

      allow update: if isAdmin() &&
        isValidId(appId) &&
        hasValidKeyCount() &&
        isValidHubApp(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'desc', 'url', 'icon', 'enabled', 'sortOrder', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(appId);
    }

    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(logId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll(['actorUid', 'actorEmail', 'eventType', 'summary', 'severity', 'createdAt']) &&
        incoming().keys().hasOnly(['actorUid', 'actorEmail', 'eventType', 'summary', 'severity', 'createdAt']) &&
        isValidAdminAuditLog(incoming());

      // Append-Only Audit Trail
      allow update, delete: if false;
    }

    // =========================================================================
    // 9. Customer Root Document & Subcollections (Strict Owner UID Isolation + Zero User Listing)
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        hasValidKeyCount() &&
        incoming().keys().hasAll([
          'userId', 'displayName', 'email', 'customerCode',
          'darkModeEnabled', 'dpdpConsentAccepted', 'dpdpConsentVersion',
          'gmailSyncEnabled', 'driveAutoSaveEnabled', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'email', 'customerCode', 'phone', 'address',
          'darkModeEnabled', 'dpdpConsentAccepted', 'dpdpConsentVersion',
          'gmailSyncEnabled', 'driveAutoSaveEnabled', 'createdAt', 'updatedAt'
        ]) &&
        isValidCustomerProfile(incoming(), userId) &&
        (isOwner(userId) || isAdmin());

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        hasValidKeyCount() &&
        isValidCustomerProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'phone', 'address', 'darkModeEnabled',
            'dpdpConsentAccepted', 'dpdpConsentVersion',
            'gmailSyncEnabled', 'driveAutoSaveEnabled', 'updatedAt'
          ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'email', 'customerCode', 'phone', 'address',
            'darkModeEnabled', 'dpdpConsentAccepted', 'dpdpConsentVersion',
            'gmailSyncEnabled', 'driveAutoSaveEnabled', 'updatedAt'
          ]))
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      match /warranties/{warrantyId} {
        allow get: if isValidId(warrantyId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isSignedIn() &&
          isValidId(warrantyId) &&
          hasValidKeyCount() &&
          incoming().keys().hasAll([
            'userId', 'deviceType', 'productName', 'modelCode', 'serialNumber',
            'locationTag', 'installEpochDay', 'warrantyTotalDays', 'unitStatus',
            'invoiceNumber', 'purchaseAmountInr', 'gstAmountInr', 'dealerName',
            'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'deviceType', 'productName', 'modelCode', 'serialNumber',
            'locationTag', 'installEpochDay', 'warrantyTotalDays', 'unitStatus',
            'invoiceNumber', 'purchaseAmountInr', 'gstAmountInr', 'dealerName',
            'createdAt', 'updatedAt'
          ]) &&
          isValidWarrantyUnit(incoming(), userId) &&
          (isOwner(userId) || isAdmin());

        allow update: if isSignedIn() &&
          isValidId(warrantyId) &&
          hasValidKeyCount() &&
          isValidWarrantyUnit(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'locationTag', 'unitStatus', 'updatedAt'
            ])) ||
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
              'deviceType', 'productName', 'modelCode', 'serialNumber',
              'locationTag', 'installEpochDay', 'warrantyTotalDays', 'unitStatus',
              'invoiceNumber', 'purchaseAmountInr', 'gstAmountInr', 'dealerName', 'updatedAt'
            ]))
          );

        allow delete: if isValidId(warrantyId) && (isOwner(userId) || isAdmin());
      }

      match /serviceRequests/{requestId} {
        allow get: if isValidId(requestId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isSignedIn() &&
          isValidId(requestId) &&
          hasValidKeyCount() &&
          incoming().keys().hasAll([
            'userId', 'ticketNumber', 'warrantyId', 'deviceLabel',
            'issueCategory', 'issueNote', 'preferredSlot', 'status',
            'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'ticketNumber', 'warrantyId', 'deviceLabel',
            'issueCategory', 'issueNote', 'preferredSlot', 'status',
            'createdAt', 'updatedAt'
          ]) &&
          isValidServiceRequest(incoming(), userId) &&
          ((isOwner(userId) && incoming().status == 'LOGGED') || isAdmin());

        allow update: if isSignedIn() &&
          isValidId(requestId) &&
          hasValidKeyCount() &&
          isValidServiceRequest(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (
            (isOwner(userId) && existing().status != 'RESOLVED' && incoming().diff(existing()).affectedKeys().hasOnly([
              'issueNote', 'preferredSlot', 'status', 'updatedAt'
            ])) ||
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
              'issueCategory', 'issueNote', 'preferredSlot', 'status', 'updatedAt'
            ]))
          );

        allow delete: if isValidId(requestId) && (isOwner(userId) || isAdmin());
      }

      match /privacyRequests/{reqId} {
        allow get: if isValidId(reqId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isSignedIn() &&
          isValidId(reqId) &&
          hasValidKeyCount() &&
          incoming().keys().hasAll([
            'userId', 'actionType', 'details', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'actionType', 'details', 'createdAt', 'updatedAt'
          ]) &&
          isValidPrivacyAuditLog(incoming(), userId) &&
          (isOwner(userId) || isAdmin());

        allow update: if false;
        allow delete: if isValidId(reqId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
